{% extends "layouts/page.njk" %}
{% from "features/audit-page-detail/_statement-card.njk" import statementCard %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      { text: "Choose a category", href: "/" },
      { text: category.title, href: "/audit/subjects/" + category.id },
      { text: "Pages", href: backHref },
      { text: page.title }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-three-quarters">
        <h1 class="govuk-heading-xl">{{ page.title }}</h1>
        <p class="govuk-body">
          <a class="govuk-link" href="{{ page.url }}" rel="noopener noreferrer" target="_blank">View the live page (opens in new tab)</a>
        </p>
        <p class="govuk-body">
          <a class="govuk-link" href="{{ pairsHref }}">View by match</a>
        </p>

        <nav class="audit-filter-bar" aria-label="Filter guidance by group">
          <p class="govuk-body govuk-!-margin-bottom-2">Filter by group</p>
          <ul class="audit-filter-bar__list">
            {% for option in filterOptions %}
              <li class="audit-filter-bar__item">
                <a class="audit-filter-bar__link" href="{{ option.href }}">
                  <strong class="govuk-tag {% if option.tone %}govuk-tag--{{ option.tone }}{% endif %} audit-filter-bar__tag">
                    {% if option.count != null %}{{ option.label }} ({{ option.count }}){% else %}{{ option.label }}{% endif %}
                  </strong>
                </a>
              </li>
            {% endfor %}
          </ul>
          {% if activeOption %}
            <p class="govuk-body govuk-!-margin-top-3 govuk-!-margin-bottom-0">
              <a class="govuk-link" href="{{ clearFilterHref }}">Clear filter</a>
            </p>
          {% endif %}
        </nav>

        {% if activeOption %}
          <p class="audit-filter-bar__selected govuk-body govuk-!-margin-top-6 govuk-!-margin-bottom-2">
            Selected:
            <strong class="govuk-tag {% if activeOption.tone %}govuk-tag--{{ activeOption.tone }}{% endif %} audit-filter-bar__tag" aria-current="page">
              {{ activeOption.label }} ({{ activeOption.count }})
            </strong>
          </p>
        {% endif %}

        <section id="statements" aria-labelledby="statements-heading" class="govuk-!-margin-top-6">
          <h2 id="statements-heading" class="govuk-heading-l">Guidance statements</h2>
          {% if hasGuidanceRows %}
            {% for row in guidanceRows %}
              <div id="guidance-{{ row.id }}" class="govuk-summary-card govuk-!-margin-bottom-6 audit-guidance-row" style="border-top:6px solid {{ row.primaryBorderColour }};">
                <div class="govuk-summary-card__title-wrapper">
                  <h3 class="govuk-summary-card__title govuk-heading-s govuk-!-margin-bottom-0">
                    <span class="govuk-visually-hidden">{{ row.primaryLabel }}: {{ row.guidanceText }}</span>
                    <span aria-hidden="true">{{ row.primaryLabel }}</span>
                  </h3>
                  <div class="audit-status-chips" aria-label="Status summary">
                    <strong class="govuk-tag govuk-tag--{{ row.primaryTone }}">
                      {{ row.primaryLabel }}{% if row.primaryChipCount > 1 %} ({{ row.primaryChipCount }}){% endif %}
                    </strong>
                    {% for chip in row.chips %}
                      {% if chip.status != row.primaryStatus %}
                        <strong class="govuk-tag govuk-tag--{{ chip.tone }}">
                          {{ chip.label }}{% if chip.count > 1 %} ({{ chip.count }}){% endif %}
                        </strong>
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>
                <div class="govuk-summary-card__content">
                  <p class="govuk-body govuk-!-margin-bottom-4">{{ row.guidanceText }}</p>

                  {% if row.rowKind == 'fallback' %}
                    <p class="govuk-body">{{ row.primaryMeaning }}</p>
                  {% elif row.pairCount == 1 %}
                    {{ statementCard(row.comparisons[0]) }}
                  {% else %}
                    <details class="govuk-details" data-module="govuk-details">
                      <summary class="govuk-details__summary">
                        <span class="govuk-details__summary-text">
                          Show {{ row.pairCount }} law matches
                        </span>
                      </summary>
                      <div class="govuk-details__text">
                        {% for s in row.comparisons %}
                          {{ statementCard(s) }}
                        {% endfor %}
                      </div>
                    </details>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% elif activeOption %}
            <p class="govuk-body">No guidance in this group on this page.</p>
          {% else %}
            <p class="govuk-body">No guidance statements on this page.</p>
          {% endif %}
        </section>
      </div>
    </div>
  </div>
{% endblock %}
