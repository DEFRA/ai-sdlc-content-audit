{#
  Pair / fallback statement card shared by aggregated and pairs page-detail views.
  Presentation fields come from presentComparisonCard() where available.
  Pass showGuidanceText: false on the aggregated view to avoid repeating the
  parent guidance proposition. Defaults to true for focused pair-review pages.
#}
{% macro statementCard(s) %}
  {% set showGuidance = true if s.showGuidanceText is not defined else s.showGuidanceText %}
  {% set statusLabel = s.pairStatusLabel if s.pairStatusLabel else s.statusLabel %}
  {% set tagClass = s.pairGovukTagClass if s.pairGovukTagClass else ("govuk-tag--" + s.statusTone) %}
  {% set accessibleOutcome = s.pairAccessibleLabel if s.pairAccessibleLabel else ("Law comparison outcome: " + statusLabel) %}
  {% set heading = s.heading if s.heading else statusLabel %}
  {% set headingId = s.headingId if s.headingId else ("comparison-heading-" + s.id) %}
  {% set headingLevel = s.headingLevel if s.headingLevel else 3 %}
  {% set assessmentHeading = s.assessmentHeading if s.assessmentHeading else "Assessment" %}
  {% set assessmentText = s.assessmentText if s.assessmentText else (s.explanation if s.explanation else "No assessment explanation is available for this comparison.") %}
  {% set lawContentLabel = s.lawContentLabel if s.lawContentLabel else none %}
  {% set lawContent = s.lawContent if s.lawContent is defined else s.lawText %}
  {% set sourceTitle = s.sourceTitle if s.sourceTitle is defined else s.lawName %}
  {% set sourceLocator = s.sourceLocator if s.sourceLocator else none %}
  {% set sourceUrl = s.sourceUrl if s.sourceUrl is defined else s.lawUrl %}
  {% set sourceLinkText = s.sourceLinkText if s.sourceLinkText else none %}
  {% set cardClass = "govuk-summary-card govuk-!-margin-bottom-4 audit-statement-card" %}
  {% if s.dimmed %}{% set cardClass = cardClass + " audit-statement-card--dimmed" %}{% endif %}

  <div id="statement-{{ s.id }}" class="{{ cardClass }}">
    <div class="govuk-summary-card__title-wrapper">
      <h{{ headingLevel }} id="{{ headingId }}" class="govuk-summary-card__title govuk-heading-s govuk-!-margin-bottom-0">
        {{ heading }}
        {% if s.dimmed %}
          <span class="govuk-!-font-size-16 govuk-!-font-weight-regular govuk-!-margin-left-2">Not in this filter</span>
        {% endif %}
      </h{{ headingLevel }}>
      <strong class="govuk-tag {{ tagClass }}">
        <span class="govuk-visually-hidden">{{ accessibleOutcome }}</span>
        <span aria-hidden="true">{{ statusLabel }}</span>
      </strong>
    </div>
    <div class="govuk-summary-card__content">
      {% if showGuidance and s.guidanceText %}
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">This guidance says</p>
        <p class="govuk-body govuk-!-margin-bottom-4">{{ s.guidanceText }}</p>
      {% endif %}

      {% if sourceTitle or sourceLocator %}
        <div class="audit-statement-card__source govuk-!-margin-bottom-4">
          {% if sourceTitle %}
            <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ sourceTitle }}</p>
          {% endif %}
          {% if sourceLocator %}
            <p class="govuk-body-s govuk-!-margin-bottom-0 audit-statement-card__locator">{{ sourceLocator }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if lawContent %}
        <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ lawContentLabel if lawContentLabel else "Legal proposition" }}</p>
        <p class="govuk-body govuk-!-margin-bottom-4">{{ lawContent }}</p>
      {% endif %}

      <p class="govuk-body govuk-!-font-weight-bold govuk-!-margin-bottom-1">{{ assessmentHeading }}</p>
      <p class="govuk-body{% if sourceUrl and sourceLinkText %} govuk-!-margin-bottom-4{% else %} govuk-!-margin-bottom-0{% endif %}">{{ assessmentText }}</p>

      {% if sourceUrl and sourceLinkText %}
        <p class="govuk-body govuk-!-margin-bottom-0">
          <a class="govuk-link" href="{{ sourceUrl }}" rel="noopener noreferrer" target="_blank">{{ sourceLinkText }}</a>
        </p>
      {% endif %}
    </div>
  </div>
{% endmacro %}
