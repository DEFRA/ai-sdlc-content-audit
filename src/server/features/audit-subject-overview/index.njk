{% extends "layouts/page.njk" %}

{% block beforeContent %}
  {{ govukBreadcrumbs({
    items: [
      { text: "Choose a category", href: "/" },
      { text: category.title }
    ]
  }) }}
{% endblock %}

{% block content %}
  <div class="govuk-width-container">
    <div class="govuk-grid-row">
      <div class="govuk-grid-column-three-quarters">
        <h1 class="govuk-heading-xl">{{ category.title }}</h1>

        <h2 class="govuk-heading-l govuk-!-margin-top-6">What we audited</h2>

        <dl class="govuk-summary-list govuk-summary-list--no-border">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Initial search term</dt>
            <dd class="govuk-summary-list__value">{{ initialSearchTerm }}</dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">What this covers</dt>
            <dd class="govuk-summary-list__value">{{ expandedDescription }}</dd>
          </div>
        </dl>

        <details class="govuk-details" data-module="govuk-details">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">How we chose this description</span>
          </summary>
          <div class="govuk-details__text">
            <p class="govuk-body">
              We started from the search term <strong>{{ initialSearchTerm }}</strong>.
              On its own that is a short phrase, which makes it hard to match against
              long pieces of guidance and law.
            </p>
            <p class="govuk-body">
              Using a mix of techniques based on <em>semantic similarity searching</em>
              (matching by meaning, not just by exact words), we expanded the search term
              into the longer description above. The longer description has more clues in it,
              so it finds more of the guidance pages and laws that really belong to this subject.
            </p>
          </div>
        </details>

        <h2 class="govuk-heading-l govuk-!-margin-top-6">What we found</h2>
        <dl class="govuk-summary-list">
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Laws we found</dt>
            <dd class="govuk-summary-list__value">
              <a class="govuk-link govuk-!-font-size-24" href="{{ lawsHref }}">{{ lawsFound }}</a>
            </dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Pages we checked</dt>
            <dd class="govuk-summary-list__value"><strong class="govuk-!-font-size-24">{{ totalPagesAudited }}</strong></dd>
          </div>
          <div class="govuk-summary-list__row">
            <dt class="govuk-summary-list__key">Pages about this subject</dt>
            <dd class="govuk-summary-list__value"><strong class="govuk-!-font-size-24">{{ pagesInCategory }}</strong></dd>
          </div>
        </dl>

        {% if not hasPagesInCategory %}
          <p class="govuk-body">We could not find any guidance pages about this subject.</p>
        {% endif %}
      </div>
    </div>
  </div>

  {% if hasPagesInCategory %}
    <div class="app-full-bleed">
      {# Server-driven tabs: full navigation so filter query state stays reliable. #}
      <div class="govuk-tabs">
        <h2 class="govuk-tabs__title">Review views</h2>
        <ul class="govuk-tabs__list" role="tablist">
          <li class="govuk-tabs__list-item{% if activeView == 'content-review' %} govuk-tabs__list-item--selected{% endif %}" role="presentation">
            <a class="govuk-tabs__tab" href="{{ contentReviewViewHref }}" role="tab" {% if activeView == 'content-review' %}aria-selected="true"{% else %}aria-selected="false"{% endif %}>
              Content Review
            </a>
          </li>
          <li class="govuk-tabs__list-item{% if activeView == 'law-to-guidance' %} govuk-tabs__list-item--selected{% endif %}" role="presentation">
            <a class="govuk-tabs__tab" href="{{ lawToGuidanceViewHref }}" role="tab" {% if activeView == 'law-to-guidance' %}aria-selected="true"{% else %}aria-selected="false"{% endif %}>
              Law to Guidance
            </a>
          </li>
        </ul>

        {% if activeView == 'content-review' %}
          <div class="govuk-tabs__panel" id="content-review" role="tabpanel">
            <h2 class="govuk-heading-l">Content improvement dashboard</h2>
            {% include "partials/improvement-dashboard.njk" %}
          </div>
        {% else %}
          <div class="govuk-tabs__panel" id="law-to-guidance" role="tabpanel">
            <h2 class="govuk-heading-l">Law to Guidance</h2>
            <p class="govuk-body">
              Page-level summary of how guidance propositions compare with law.
              Use this view to prioritise pages that need legal review.
            </p>
            {% include "partials/law-to-guidance-dashboard.njk" %}
          </div>
        {% endif %}
      </div>

      <p class="govuk-body govuk-!-margin-top-6">
        <a class="govuk-link govuk-link--no-visited-state" href="{{ propositionsHref }}">View all propositions for {{ category.title }}</a>
      </p>
    </div>
  {% endif %}
{% endblock %}
